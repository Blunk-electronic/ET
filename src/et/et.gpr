with "gtkada.gpr";

project et is

	for Create_Missing_Dirs use "true";

	-- This is the destination of the
	-- executable binary file:

	-- This requires adjustment of environment
	-- variable $PATH:
	--for exec_dir use "../../bin/";

	-- This places the executable in $HOME/bin
	-- which should exist in all Linux distros:	
	for exec_dir use external ("HOME") & "/bin";


	-- Object and source files:
	for object_dir use "obj/";
	for source_dirs use (
		"./" ,
		"../lib/");

	-- The name of the executable binary file:
 	for main use ("et");

	Warning_Checks := ("-gnatwaRU");
	-- R : turn off warnings for redundant construct
	-- U : turn off warnings for unused entities

	Style_Checks := ("-gnatyyd1M0-achinprs");
	-- a : check attribute casing
	-- b : check no blanks at end of line
	-- c : check comment format (two spaces)
	-- e : check end/exit label present
	-- h : check no horizontal tabs in source
	-- i : check if-then layout
	-- n : check casing of package Standard identifiers
	-- p : check pragma casing
	-- r : check casing for identifier references
	-- s : check separate subprogram specs present
	-- t : check token separation rules

	Switches :=
		Warning_Checks
		& Style_Checks
		& "-gnatVa"
--		& "-FPIE"		-- To link GtkAda dynamically
		& "-g";

	package Compiler is
		for Default_Switches ("Ada") use Switches;
	end Compiler;
 	
end et;

-- see https://docs.adacore.com/gprbuild-docs/html/gprbuild_ug/gnat_project_manager.html
-- http://www.pegasoft.ca/resources/boblap/7.html

-- build with command "gprbuild -j4"
-- build with command "gprbuild -j4 -gnatm4"
-- build with command "gprbuild -j4 -g et"
-- clean up with command "gprclean"
